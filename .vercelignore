# Vercel only needs what `bun run build` reads: index.html, src, public,
# package.json, bun.lock, tsconfig*.json and vite.config.ts

# Tests
/e2e
/playwright.config.ts
/vitest.config.ts
/src/**/*.test.ts
/test-results
/playwright-report
/blob-report
/coverage

# Docs
/*.md
/LICENSE

# Editor, agent and repo tooling
/.claude
/.github
/.husky
/.vscode
/.commitlintrc.json
/.editorconfig
/.prettierignore
/.prettierrc
/eslint.config.js

# Local files
/build
/node_modules
.env
.env.*
.DS_Store
